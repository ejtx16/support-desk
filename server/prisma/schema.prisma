// SQLite has no native enums: role/status/priority/category/type are stored as
// strings and validated by the single source of truth in src/domain/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestedTickets Ticket[]      @relation("TicketRequester")
  assignedTickets  Ticket[]      @relation("TicketAssignee")
  comments         Comment[]
  events           TicketEvent[]
}

model Ticket {
  id          String    @id @default(cuid())
  number      Int       @unique
  title       String
  description String
  category    String
  priority    String    @default("MEDIUM")
  // Numeric mirror of priority (LOW=1 .. URGENT=4) so the DB can sort by importance.
  priorityRank Int      @default(2)
  status      String    @default("OPEN")
  dueAt       DateTime
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requesterId String
  requester   User    @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments Comment[]
  events   TicketEvent[]

  @@index([status])
  @@index([priorityRank])
  @@index([assigneeId])
  @@index([requesterId])
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  type      String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId  String
  actor    User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
